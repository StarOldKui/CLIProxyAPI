+const buildCachedAntigravityGroups = (body: unknown): AntigravityQuotaGroup[] => {
+  const payload = parseAntigravityPayload(body);
+  if (!payload) return [];
+  if (Array.isArray(payload.groups)) {
+    return buildAntigravityQuotaGroups(payload as AntigravityQuotaSummaryPayload);
+  }
+  const models = payload.models;
+  if (!models || typeof models !== 'object' || Array.isArray(models)) return [];
+
+  return Object.entries(models as Record<string, unknown>).flatMap(([modelId, value]) => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) return [];
+    const model = value as Record<string, unknown>;
+    const rawQuota = model.quotaInfo ?? model.quota_info;
+    if (!rawQuota || typeof rawQuota !== 'object' || Array.isArray(rawQuota)) return [];
+    const quota = rawQuota as Record<string, unknown>;
+    const remainingFraction = normalizeQuotaFraction(
+      quota.remainingFraction ?? quota.remaining_fraction ?? quota.remaining
+    );
+    if (remainingFraction === null) return [];
+    const label = normalizeStringValue(model.displayName ?? model.display_name) ?? modelId;
+    const resetTime = normalizeStringValue(quota.resetTime ?? quota.reset_time) ?? undefined;
+    return [
+      {
+        id: modelId,
+        label,
+        buckets: [{ id: modelId, label, remainingFraction, resetTime }],
+      },
+    ];
+  });
+};
+
+export const getCachedAntigravityQuotaState = (
+  file: AuthFileItem,
+  t: TFunction
+): AntigravityQuotaState | null => {
+  const snapshot = getQuotaSnapshot(file);
+  const updatedAt = getSnapshotText(snapshot?.updated_at);
+  if (!snapshot || !updatedAt) return null;
+  if (snapshot.status !== 'success') {
+    return {
+      status: 'error',
+      groups: [],
+      subscription: null,
+      serverTimeOffsetMs: null,
+      error: getSnapshotText(snapshot.error) ?? t('common.unknown_error'),
+      errorStatus: getSnapshotErrorStatus(snapshot),
+      updatedAt,
+    };
+  }
+  const groups = buildCachedAntigravityGroups(snapshot.body);
+  if (groups.length === 0) {
+    return {
+      status: 'error',
+      groups: [],
+      subscription: null,
+      serverTimeOffsetMs: null,
+      error: t('antigravity_quota.empty_models'),
+      updatedAt,
+    };
+  }
+  return { status: 'success', groups, subscription: null, serverTimeOffsetMs: null, updatedAt };
+};
+
