@@ -0,0 +1,125 @@
+import { describe, expect, test } from 'bun:test';
+import type { TFunction } from 'i18next';
+import { getCachedAntigravityQuotaState } from '@/features/quota/providers/antigravity/data';
+import { getCachedClaudeQuotaState } from '@/features/quota/providers/claude/data';
+import { getCachedCodexQuotaState } from '@/features/quota/providers/codex/data';
+import { getCachedKimiQuotaState } from '@/features/quota/providers/kimi/data';
+import { getCachedXaiQuotaState } from '@/features/quota/providers/xai/data';
+
+const t = ((key: string) => key) as TFunction;
+const updatedAt = '2026-08-24T06:57:52Z';
+
+describe('cached quota states', () => {
+  test('hydrates Codex and Claude windows', () => {
+    const codex = getCachedCodexQuotaState(
+      {
+        name: 'codex.json',
+        type: 'codex',
+        quota: {
+          status: 'success',
+          updated_at: updatedAt,
+          body: JSON.stringify({
+            plan_type: 'pro',
+            rate_limit: {
+              primary_window: {
+                used_percent: 25,
+                limit_window_seconds: 18000,
+                reset_at: 1785902974,
+              },
+            },
+          }),
+        },
+      },
+      t
+    );
+    const claude = getCachedClaudeQuotaState(
+      {
+        name: 'claude.json',
+        type: 'claude',
+        quota: {
+          status: 'success',
+          updated_at: updatedAt,
+          body: JSON.stringify({ five_hour: { utilization: 40, resets_at: updatedAt } }),
+        },
+      },
+      t
+    );
+
+    expect(codex).toMatchObject({ status: 'success', planType: 'pro', updatedAt });
+    expect(codex?.windows[0]?.usedPercent).toBe(25);
+    expect(claude).toMatchObject({ status: 'success', updatedAt });
+    expect(claude?.windows[0]?.usedPercent).toBe(40);
+  });
+
+  test('hydrates legacy Antigravity models and Kimi usage', () => {
+    const antigravity = getCachedAntigravityQuotaState(
+      {
+        name: 'antigravity.json',
+        type: 'antigravity',
+        quota: {
+          status: 'success',
+          updated_at: updatedAt,
+          body: JSON.stringify({
+            models: {
+              'gemini-test': {
+                displayName: 'Gemini Test',
+                quotaInfo: { remainingFraction: 0.75, resetTime: updatedAt },
+              },
+            },
+          }),
+        },
+      },
+      t
+    );
+    const kimi = getCachedKimiQuotaState(
+      {
+        name: 'kimi.json',
+        type: 'kimi',
+        quota: {
+          status: 'success',
+          updated_at: updatedAt,
+          body: JSON.stringify({ usage: { used: 10, limit: 100, remaining: 90 } }),
+        },
+      },
+      t
+    );
+
+    expect(antigravity).toMatchObject({ status: 'success', updatedAt });
+    expect(antigravity?.groups[0]?.buckets[0]?.remainingFraction).toBe(0.75);
+    expect(kimi).toMatchObject({ status: 'success', updatedAt });
+    expect(kimi?.rows[0]).toMatchObject({ used: 10, limit: 100 });
+  });
+
+  test('hydrates merged xAI billing and persisted errors', () => {
+    const xai = getCachedXaiQuotaState(
+      {
+        name: 'xai.json',
+        type: 'xai',
+        quota: {
+          status: 'success',
+          updated_at: updatedAt,
+          body: JSON.stringify({ config: { creditUsagePercent: 65 } }),
+          supplementary_body: JSON.stringify({ config: { monthlyLimit: { val: 0 } } }),
+        },
+      },
+      t
+    );
+    const error = getCachedXaiQuotaState(
+      {
+        name: 'xai-error.json',
+        type: 'xai',
+        quota: { status: 'error', status_code: 401, error: 'invalid token', updated_at: updatedAt },
+      },
+      t
+    );
+
+    expect(xai).toMatchObject({ status: 'success', billing: { usagePercent: 65 }, updatedAt });
+    expect(error).toEqual({
+      status: 'error',
+      billing: null,
+      error: 'invalid token',
+      errorStatus: 401,
+      updatedAt,
+    });
+  });
+});
