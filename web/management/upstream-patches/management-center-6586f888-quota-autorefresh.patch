@@ -0,0 +1,29 @@
+import type { AuthFileItem } from '@/types';
+
+export interface QuotaSnapshot {
+  status?: unknown;
+  status_code?: unknown;
+  body?: unknown;
+  error?: unknown;
+  updated_at?: unknown;
+  profile_body?: unknown;
+  supplementary_body?: unknown;
+  plan_type?: unknown;
+  subscription_active_until?: unknown;
+}
+
+export const getQuotaSnapshot = (file: AuthFileItem): QuotaSnapshot | null => {
+  const snapshot = file.quota;
+  return snapshot && typeof snapshot === 'object' && !Array.isArray(snapshot)
+    ? (snapshot as QuotaSnapshot)
+    : null;
+};
+
+export const getSnapshotErrorStatus = (snapshot: QuotaSnapshot): number | undefined => {
+  const status = Number(snapshot.status_code);
+  return Number.isFinite(status) && status > 0 ? status : undefined;
+};
+
+export const getSnapshotText = (value: unknown): string | null => {
+  return typeof value === 'string' && value.trim() ? value.trim() : null;
+};
